<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-nav item background: a perfect circle (equal width and height) centred behind the selected icon,
     whatever the width of the nav cell. Nothing is drawn for unselected items. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item
                android:width="@dimen/nav_indicator_size"
                android:height="@dimen/nav_indicator_size"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/dearly_primary_container" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
