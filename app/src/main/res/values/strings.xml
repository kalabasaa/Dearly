    <string name="onb_welcome_title">Welcome to Dearly</string>
    <string name="onb_welcome_body">A calm, private place for your diary entries, thoughts and plans.</string>
    <string name="onb_features_title">What you can do</string>
    <string name="onb_feature_write">✍️  Write with bold, italics, highlights, lists, checklists, tables and stickers.</string>
    <string name="onb_feature_organize">🗂️  Keep entries in folders and find them with tags and search.</string>
    <string name="onb_feature_remind">🔔  Set reminders that notify you on time, even offline.</string>
