<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- "1." / bullet: a direct child of the row so the row baseline-aligns it with the first line of text.
         Right-aligned in a fixed-width column so 1. and 10. both end at the same x and the text stays flush. -->
    <TextView
        android:id="@+id/tv_marker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:minWidth="32dp"
        android:paddingStart="0dp"
        android:paddingTop="0dp"
        android:paddingEnd="@dimen/space_xs"
        android:textColor="@color/dearly_text"
        android:textSize="@dimen/editor_text_size"
        android:visibility="gone" />

    <!-- Bullet: a real circle (not a font glyph), 8dp wide. Its top margin is set in BlockEditor so the
         centre sits on the middle of the first line of text. Same 32dp column as the number marker. -->
    <View
        android:id="@+id/v_bullet"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_bullet_dot"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- Checkbox column: same 32dp column as the bullet / number. Its height is set in BlockEditor to the height
         of the first text line, and the box is centred in that, so it sits level with the first line of text.
         The 24dp box starts 8dp in, so its centre (20dp) matches the centre of the bullet dot. -->
    <FrameLayout
        android:id="@+id/fl_marker"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:visibility="gone">

        <CheckBox
            android:id="@+id/cb_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/editor_checkbox"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:scaleX="0.9"
            android:scaleY="0.9" />
    </FrameLayout>

    <com.dearly.app.ui.editor.BlockEditText
        android:id="@+id/block_edit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@null"
        android:gravity="top|start"
        android:importantForAutofill="no"
        android:includeFontPadding="false"
        android:inputType="textCapSentences|textMultiLine"
        android:paddingStart="4dp"
        android:paddingTop="0dp"
        android:paddingEnd="4dp"
        android:paddingBottom="0dp"
        android:textColor="@color/dearly_text"
        android:textColorHighlight="@color/dearly_selection"
        android:textSize="@dimen/editor_text_size" />
</LinearLayout>
