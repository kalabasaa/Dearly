<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dearly_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/list_bottom_padding"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin"
            android:paddingTop="@dimen/page_title_top"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="@dimen/page_margin">

            <TextView
                android:id="@+id/tv_greeting"
                style="@style/TextAppearance.Dearly.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/TextAppearance.Dearly.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_subtitle" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_search"
                style="@style/Widget.Dearly.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:clickable="true"
                android:contentDescription="@string/search_hint"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/control_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search"
                        app:tint="@color/dearly_text_secondary" />

                    <TextView
                        style="@style/TextAppearance.Dearly.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/search_hint"
                        android:textColor="@color/dearly_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Folders -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Dearly.Heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/section_folders" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_all_folders"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/text_button_inset"
                    android:text="@string/view_all" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_folders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/empty_folders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/TextAppearance.Dearly.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_folders_home"
                    android:textColor="@color/dearly_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_create_folder"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_marginTop="@dimen/space_sm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/create_folder" />
            </LinearLayout>

            <!-- Pinned -->
            <TextView
                style="@style/TextAppearance.Dearly.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:layout_marginBottom="@dimen/space_sm"
                android:accessibilityHeading="true"
                android:text="@string/section_pinned" />

            <LinearLayout
                android:id="@+id/ll_pinned"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_empty_pinned"
                style="@style/TextAppearance.Dearly.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/empty_pinned_home"
                android:textColor="@color/dearly_text_secondary"
                android:visibility="gone" />

            <!-- Latest -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Dearly.Heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/section_latest" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_all_notes"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/text_button_inset"
                    android:text="@string/view_all_notes" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_latest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/empty_latest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/TextAppearance.Dearly.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_notes_home"
                    android:textColor="@color/dearly_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_create_note"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_marginTop="@dimen/space_sm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/create_note" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/fab_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dearly_scrim"
        android:clickable="true"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_sm"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="end"
        android:orientation="vertical"
        android:padding="@dimen/space_sm">

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab_create_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:text="@string/create_note"
            android:visibility="gone"
            app:icon="@drawable/ic_note" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab_create_folder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:text="@string/create_folder"
            android:visibility="gone"
            app:icon="@drawable/ic_folder" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_main"
            style="@style/Widget.Dearly.Fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/fab_open"
            android:src="@drawable/ic_add" />
    </LinearLayout>
</FrameLayout>
