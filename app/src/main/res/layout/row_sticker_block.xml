<?xml version="1.0" encoding="utf-8"?>
<!-- A sticker in a note: small, left-aligned. Tap it to show the size slider and the remove button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/iv_sticker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:adjustViewBounds="true"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="@string/sticker_image"
        android:focusable="true"
        android:scaleType="fitStart" />

    <LinearLayout
        android:id="@+id/ll_sticker_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_size"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/sticker_size"
            android:stepSize="8"
            android:valueFrom="32"
            android:valueTo="200" />

        <ImageButton
            android:id="@+id/btn_remove_sticker"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/sticker_remove_from_note"
            android:src="@drawable/ic_close" />
    </LinearLayout>
</LinearLayout>
